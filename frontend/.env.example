# Copy to .env.local (gitignored). Server-only values: never prefix them with NEXT_PUBLIC_.

# AI agent
GEMINI_API_KEY=       # Google AI Studio key: the default (free) model
ANTHROPIC_API_KEY=         # optional: enables Claude as the premium model
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash   # tried when the main model is overloaded
# CLAUDE_MODEL=claude-opus-5-5
# AGENT_PREMIUM_FEE=1      # tUSD per premium message, charged from the user's agent vault
AGENT_PRIVATE_KEY=         # the agent's own key; RiftAgentVaultFactory was deployed with its address
AGENT_ADDRESS=
AUTOPILOT_SECRET=          # bearer token for POST /api/agent/autopilot
# AUTOPILOT_INTERVAL_SEC=60  # background autopilot pass interval; 0 turns it off
DATABASE_URL=              # Neon (pooled): autopilot rules and log; without it a local file is used
DATABASE_URL_UNPOOLED=     # Neon (direct): schema setup

# Public (built into the page)
# NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_UNICHAIN_SEPOLIA_RPC=
