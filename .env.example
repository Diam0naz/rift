# Copy to .env and fill in. Never commit .env.
PRIVATE_KEY=0x...

# RPCs. Check the Lasna RPC against dev.reactive.network (Reactive Mainnet & Lasna Testnet page).
LASNA_RPC=https://lasna-rpc.rnk.dev/
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

# --- filled in as you deploy (see README "Deploy") ---
POOL_BASE=
VAULT=
VAULT_ASSET=
VAULT_BAL=
POOL_UNI=
MARKET=
REACTIVE=

# --- optional RiftReactive params (defaults shown) ---
# TRIP_SPREAD_BPS=500
# SUSTAIN_SECONDS=2
# WINDOW_SECONDS=300
# TRIP_OUTFLOW_BPS=1500
# MARK_EPSILON_BPS=10
# MARK_HEARTBEAT=60
# CRON_TOPIC=0xe20b31294d84c3661ddc8f423abb9c70310d0cf172aa2714ead78029b325e3f4   # default: Cron1000 (~17 min, ~1 lREACT/day)
#   drives the mark heartbeat that RiftMarket's liveness check (maxMarkAge) relies on. 0 disables it.
#   Avoid Cron10 (~10s): it burns ~100 lREACT/day.
# MARK_HEARTBEAT=600            # resend the mark at least this often (s), even if unchanged
# MARK_SMOOTHING_SECONDS=30     # time constant of the time-weighted perp mark; 0 = raw spread
# MIN_QUOTE_RESERVE=1000000000000000000000   # ignore Syncs from pools with less token1 than this (1,000e18)
# REACTIVE_FUNDING=1000000000000000000
# MARKET_CALLBACK_FUNDING=10000000000000000
